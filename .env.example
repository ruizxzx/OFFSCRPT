# ===================================================
# KRISHFICIENT - Production Environment Variables
# For Vercel Deployment & Local Development
# ===================================================

# Firebase Web Client Configuration (Public Vite Variables)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Do not set VITE_FIREBASE_DATABASE_ID. This application uses Firestore's
# default database in the krishficient-portfolio Firebase project.

# OFFSCRPT Media Storage (Cloudflare R2) - server-side only; NEVER prefix these with VITE_
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="offscrpt-media"
# Private bucket for protected digital-product files (V88+). Do not use a public-only bucket.
R2_PRODUCT_BUCKET_NAME=""
R2_PRODUCT_ACCOUNT_ID=""
R2_PRODUCT_ACCESS_KEY_ID=""
R2_PRODUCT_SECRET_ACCESS_KEY=""
R2_PRODUCT_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_PUBLIC_BASE_URL="https://media.example.com"
OFFSCRPT_ADMIN_EMAILS="ruizxzxz@gmail.com,krishsarkar456@gmail.com"
OFFSCRPT_MAX_IMAGE_BYTES="10485760"
OFFSCRPT_MAX_VIDEO_BYTES="262144000"
OFFSCRPT_MAX_FILE_BYTES="26214400"

# Server-only OpenRouter AI (V79)
# Keep this key server-side; never prefix it with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_FAST=openrouter/free
OPENROUTER_MODEL_BALANCED=openrouter/free
OPENROUTER_MODEL_DEEP=openrouter/free
OPENROUTER_FALLBACK_MODELS=openrouter/free
OPENROUTER_DAILY_REQUEST_LIMIT=50
OPENROUTER_MAX_CONTEXT_CHARS=30000
OPENROUTER_CACHE_TTL_SECONDS=86400
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_OUTPUT_TOKENS=5000
OPENROUTER_HTTP_REFERER=https://offscrpt.vercel.app
OPENROUTER_APP_TITLE=OFFSCRPT

# V84 optional semantic knowledge providers (server-only)
OFFSCRPT_EMBEDDING_ENDPOINT=
OFFSCRPT_EMBEDDING_API_KEY=
OFFSCRPT_EMBEDDING_MODEL=
OFFSCRPT_VECTOR_ENDPOINT=
OFFSCRPT_VECTOR_API_KEY=
OFFSCRPT_SEARCH_ENDPOINT=
OFFSCRPT_KNOWLEDGE_WORKER_SECRET=

# V85.1 scheduled publishing (server-side only)
GOOGLE_CLOUD_PROJECT=
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
CRON_SECRET=

# V86 Commerce Foundation (server-side only)
# V86 test mode performs no real payment. Use a provider adapter in a future release for live payments.
COMMERCE_PAYMENT_MODE=test
FIREBASE_WEB_API_KEY=



# V90 Razorpay Payments (server-side except the public Vite Key ID)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ENVIRONMENT=test
RAZORPAY_API_VERSION=v1
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=
OFFSCRPT_PRODUCTION_URL=https://offscrpt.vercel.app
